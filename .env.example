# Complete Environment Configuration for Haptic Friends

# ====================
# Database Configuration
# ====================
DB_NAME=haptic_friends
DB_USER=haptic_user
DB_PASSWORD=change_this_secure_password
DB_HOST=localhost
DB_PORT=5432

# ====================
# Redis Configuration
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ====================
# Backend API Configuration
# ====================
NODE_ENV=production
PORT=3000
API_VERSION=v1

# ====================
# JWT Secrets
# ====================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====================
# Apple Sign In
# ====================
APPLE_CLIENT_ID=com.yourcompany.hapticfriends
APPLE_TEAM_ID=YOUR_10_CHAR_TEAM_ID
APPLE_KEY_ID=YOUR_10_CHAR_KEY_ID
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey.p8

# ====================
# Google OAuth
# ====================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ====================
# Apple Push Notification Service (APNS)
# ====================
APNS_KEY_PATH=/app/keys/AuthKey.p8
APNS_KEY_ID=YOUR_10_CHAR_KEY_ID
APNS_TEAM_ID=YOUR_10_CHAR_TEAM_ID
APNS_TOPIC=com.yourcompany.hapticfriends
APNS_PRODUCTION=false

# ====================
# CORS Configuration
# ====================
CORS_ORIGIN=http://localhost:80,https://hapticfriends.app

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================
# Logging
# ====================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ====================
# WebSocket Configuration
# ====================
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=5000
